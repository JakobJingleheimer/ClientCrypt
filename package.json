{
  "name": "ClientCrypt",
  "version": "0.0.0",
  "description": "Secure, offline client-side encryption demo",
  "keywords": [
    "browser",
    "encryption",
    "offline",
    "pwa"
  ],
  "homepage": "https://github.com/JakobJingleheimer/ClientCrypt#readme",
  "bugs": {
    "url": "https://github.com/JakobJingleheimer/ClientCrypt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakobJingleheimer/ClientCrypt.git"
  },
  "license": "CC-BY-NC-4.0",
  "author": "JakobJingleheimer",
  "type": "module",
  "main": "src/index.html",
  "scripts": {
    "build": "rm -rf ./dist && node ./build/prod.ts",
    "build:prod": "NODE_ENV=production node --run build",
    "dev": "NODE_ENV=development PORT=8443 rm -rf ./dist && node ./build/dev.ts",
    "start": "node --run build && node --run serve",
    "start:prod": "node --run build:prod && node --run serve",
    "serve": "PORT=8443 http-server -S -C ./cert.pem -K key.pem ./dist",
    "test:ui": "node --experimental-config-file=./node.config.test.json --import './test/dom.setup.ts' --test",
    "test:uis": "node --run test:ui -- './src/**/*.test.ts'",
    "test:vanilla": "rm -f ./test/.storage && touch ./test/.storage; node --experimental-config-file=./node.config.test.json --test",
    "test:vanillas": "node --run test:vanilla -- './build/**/*.spec.ts' './src/**/*.spec.ts'",
    "types:check": "tsc --build --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "kelpui": "^1.17.2",
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "mime-types": "^3.0.2",
    "typescript": "^7.0.2"
  }
}
